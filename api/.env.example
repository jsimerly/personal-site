# Copy to .env for local overrides. Everything here is optional in dev.
# On Cloud Run these are set as service env vars / secrets instead.

# Required in prod (api.settings.prod):
# SECRET_KEY=
# ALLOWED_HOSTS=jacobsimerly-api-123456789.us-central1.run.app

# Optional everywhere:
# CORS_ALLOWED_ORIGINS=https://jsimerly.github.io
# GCS_CACHE_SECONDS=300
